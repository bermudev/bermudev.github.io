---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;
const displayTimezone = postTimezone ?? config.site.timezone;
const publishedDatetime = dayjs(pubDatetime).tz(displayTimezone);
const modifiedDatetime = isModified
  ? dayjs(modDatetime).tz(displayTimezone)
  : null;

const publishedDate = publishedDatetime.format("D MMM, YYYY");
const modifiedDate = modifiedDatetime?.format("D MMM, YYYY");
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={publishedDatetime.toISOString()}
  >
    {publishedDate}
  </time>
  {
    modifiedDatetime && (
      <>
        <span
          aria-hidden="true"
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
        >
          |
        </span>
        <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
          {t.post.updatedAt}:
        </span>
        <time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          datetime={modifiedDatetime.toISOString()}
        >
          {modifiedDate}
        </time>
      </>
    )
  }
</div>
